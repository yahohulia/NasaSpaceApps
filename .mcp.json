{
  "mcpServers": {
    "basic-memory": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "basic-memory",
        "mcp",
        "--project",
        "sol-sandbox"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "Roblox_Studio": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/c",
        "cd /d %LOCALAPPDATA%\\Roblox && .\\mcp.bat"
      ]
    }
  }
}
